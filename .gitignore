.DS_Store

# FiiO M3 Pro: upstream Rockbox clone (the port lives in patches/) and build output
fiio_m3_pro/rockbox/
fiio_m3_pro/build-*/
fiio_m3_pro/sdcard/
fiio_m3_pro/themes/tui-only/

# Epson V500: never commit Epson's binaries (EULA forbids redistribution) or trace output
epson_v500/**/*.so*
epson_v500/**/esfw*.bin
epson_v500/**/*.deb
epson_v500/**/*.tar.gz
epson_v500/tools/trace
epson_v500/tools/writes.bin
epson_v500/photos/
epson_v500/captures/

# AlphaSmart 3000: archive.org discs (third-party copyrighted; re-fetch with tools/fetch_archive.sh)
alphasmart_3000/archive/

# Python
__pycache__/
*.egg-info/
.pytest_cache/

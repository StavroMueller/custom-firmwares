+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+
+#include "power.h"
+#include "adc.h"
+#include "system.h"
+#include "axp-192.h"
+#ifdef HAVE_CW2015
+# include "cw2015.h"
+#endif
+#ifdef HAVE_USB_CHARGING_ENABLE
+# include "usb_core.h"
+#endif
+
+#include "i2c-ingenic.h"
+
+/* CONFIRMED: AXP192 PMU at I2C2 0x34 (stock driver calls it "axp173").
+ * ASSUMED: battery curves below are the Q1's and need recalibrating with
+ * the battery_bench plugin once the port runs. */
+
+unsigned short battery_level_disksafe = 3470;
+
+/* the OF shuts down at this voltage */
+unsigned short battery_level_shutoff = 3400;
+
+/* voltages (millivolt) of 0%, 10%, ... 100% when charging disabled */
+unsigned short percent_to_volt_discharge[11] =
+{
+    3400, 3639, 3697, 3723, 3757, 3786, 3836, 3906, 3980, 4050, 4159
+};
+
+/* voltages (millivolt) of 0%, 10%, ... 100% when charging enabled */
+unsigned short percent_to_volt_charge[11] =
+{
+      3485, 3780, 3836, 3857, 3890, 3930, 3986, 4062, 4158, 4185, 4196
+};
+
+void power_init(void)
+{
+    i2c_ingenic_set_freq(AXP_PMU_BUS, I2C_FREQ_400K);
+#ifdef HAVE_CW2015
+    cw2015_init();
+#endif
+
+    /* Set lowest sample rate */
+    axp192_adc_set_rate(AXP192_ADC_RATE_25HZ);
+
+    /* Enable required ADCs */
+    axp192_adc_set_enabled(
+        (1 << AXP192_ADC_BATTERY_VOLTAGE) |
+        (1 << AXP192_ADC_CHARGE_CURRENT) |
+        (1 << AXP192_ADC_DISCHARGE_CURRENT) |
+        (1 << AXP192_ADC_VBUS_VOLTAGE) |
+        (1 << AXP192_ADC_VBUS_CURRENT) |
+        (1 << AXP192_ADC_INTERNAL_TEMP) |
+        (1 << AXP192_ADC_APS_VOLTAGE));
+
+    /* Supply rails, CONFIRMED from the stock kernel's AXP writes
+     * (fiio_axp173 driver). DCDC2 is the CPU core: stock brings it up at
+     * 1400 mV and its update_core_work then drops it to 1225 mV for normal
+     * running, which is what we use. Setting a voltage also enables the rail.
+     * The stock DCDC working-mode (reg 0x80) tweak is not replicated. */
+    axp192_supply_set_voltage(AXP192_SUPPLY_DCDC1, 3300);
+    axp192_supply_set_voltage(AXP192_SUPPLY_DCDC2, 1225);
+    axp192_supply_set_voltage(AXP192_SUPPLY_DCDC3, 1800);
+
+    /* LDO2/LDO3 = 3.3 V: stock writes 0xff to reg 0x28. Done directly
+     * because axp192_supply_set_voltage() doesn't shift the LDO2 value into
+     * its high-nibble field (it would set LDO2 to 1.8 V). Then enable both
+     * (reg 0x12 bits 2 and 3). */
+    i2c_reg_write1(AXP_PMU_BUS, AXP_PMU_ADDR, 0x28, 0xff);
+    i2c_reg_modify1(AXP_PMU_BUS, AXP_PMU_ADDR,
+                    AXP192_REG_PWROUTPUTCTRL2, 0, 0x0c, NULL);
+
+    /* Delay to give power output time to stabilize */
+    mdelay(20);
+}
+
+#ifdef HAVE_USB_CHARGING_ENABLE
+void usb_charging_maxcurrent_change(int maxcurrent)
+{
+    axp192_set_charge_current(maxcurrent);
+}
+#endif
+
+void power_off(void)
+{
+    axp192_power_off();
+    while(1);
+}
+
+bool charging_state(void)
+{
+    return axp192_battery_status() == AXP192_BATT_CHARGING;
+}
+
+unsigned int power_input_status(void)
+{
+    return axp192_power_input_status();
+}
+
+int _battery_voltage(void)
+{
+    /* CW2015 can also read battery voltage, but the AXP consistently
+     * reads ~20-30 mV higher so I suspect it's the "real" voltage. */
+    return axp192_adc_read(AXP192_ADC_BATTERY_VOLTAGE);
+}
+
+#if CONFIG_BATTERY_MEASURE & CURRENT_MEASURE
+int _battery_current(void)
+{
+    if(charging_state())
+        return axp192_adc_read(AXP192_ADC_CHARGE_CURRENT);
+    else
+        return axp192_adc_read(AXP192_ADC_DISCHARGE_CURRENT);
+}
+#endif
+
+#if defined(HAVE_CW2015) && (CONFIG_BATTERY_MEASURE & PERCENTAGE_MEASURE) != 0
+int _battery_level(void)
+{
+    return cw2015_get_soc();
+}
+#endif
+
+#if defined(HAVE_CW2015) && (CONFIG_BATTERY_MEASURE & TIME_MEASURE) != 0
+int _battery_time(void)
+{
+    return cw2015_get_rrt();
+}
+#endif
+
+void adc_init(void)
+{
+}

index 0000000..7654338
--- /dev/null
+++ b/firmware/target/mips/ingenic_x1000/fiiom3pro/lcd-fiiom3pro.c
@@ -0,0 +1,327 @@
+/***************************************************************************
+ *             __________               __   ___.
+ *   Open      \______   \ ____   ____ |  | _\_ |__   _______  ___
+ *   Source     |       _//  _ \_/ ___\|  |/ /| __ \ /  _ \  \/  /
+ *   Jukebox    |    |   (  <_> )  \___|    < | \_\ (  <_> > <  <
+ *   Firmware   |____|_  /\____/ \___  >__|_ \|___  /\____/__/\_ \
+ *                     \/            \/     \/    \/            \/
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+
+/* FiiO M3 Pro LCD.
+ *
+ * Display chain (CONFIRMED from the stock FW1.1.1 kernel):
+ *
+ *   X1000 SLCDC --16-bit 8080--> SSD1963 --RGB--> ST7701S 480x800 panel
+ *
+ * The panel glass is 480x800 but FiiO only drives columns 70..409, giving the
+ * 340x800 visible area. The SSD1963 window is set to exactly that rectangle,
+ * so the Rockbox framebuffer stays 340x800 and the LCD DMA loop's 0x2c
+ * (write memory start) restarts at the window origin every frame.
+ *
+ * Both init tables below are transcribed from the stock kernel:
+ *  - SSD1963: data table at kernel file offset 0x5f32ec
+ *  - ST7701S: inline code at 0x800125f0 (VMA), sent over a bit-banged
+ *    3-wire SPI on PC0 (SDA) / PC2 (SCK), with chip select on PB18 -- the
+ *    same line that selects the SSD1963 on the SLCD bus.
+ * See fiio_m3_pro/HARDWARE.md for the decoding.
+ *
+ * Performance note: lcd-x1000.c runs the LCD DMA as a continuous loop that
+ * re-sends the whole shadow framebuffer, so lcd_update_rect() only shortens
+ * the RAM->RAM copy; bus traffic is constant. The SLCD write clock below and
+ * the 16-bit bus width are what set the achievable refresh rate.
+ */
+
+#include "lcd.h"
+#include "kernel.h"
+#include "system.h"
+#include "lcd-x1000.h"
+#include "gpio-ingenic.h"
+
+/* SLCD write clock: CONFIRMED 30 MHz on the stock OS (LPCDR = MPLL 600 MHz
+ * / 20). The SSD1963's 8080 interface can go faster; raise it later while
+ * watching for corruption. 340x800 at one write per pixel is 272000 writes
+ * per frame. */
+#define M3PRO_LCD_WR_CLOCK      30000000
+
+/* Visible window inside the 480-column panel (stock 0x2a parameters) */
+#define PANEL_X0                70
+#define PANEL_X1                (PANEL_X0 + LCD_WIDTH - 1)  /* 409 */
+
+#define HI(x)   (((x) >> 8) & 0xff)
+#define LO(x)   ((x) & 0xff)

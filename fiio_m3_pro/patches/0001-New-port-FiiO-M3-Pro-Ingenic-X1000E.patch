+# Cabbie v2.0
+# (C) 2007-2012 The Authors (see /rockbox/wps/AUTHORS)
+# Derived from "cabbie" (C) Yohann Misquitta
+#
+# 340x800 variant (FiiO M3 Pro), derived from the 360x640 layout: x shifted
+# by -10 and everything below the content area moved down by 160 px, to
+# match backdrop-340x800x16.bmp, whose fixed landmarks are:
+#   title bar       x=20..319 y=6..27
+#   progress trough x=20..319 y=676..697
+#   status row      y=765..793, with shuffle at x=199 and repeat at x=263
+# The content area is y=28..675; album art is enlarged to 300x300.
+#
+# Disable Status Bar
+%wd
+#
+# Load Backdrop
+%X(backdrop-340x800x16.bmp)
+#
+# Preload Images
+%xl(A,lock-340x800x16.bmp,0,0,2)
+%xl(B,battery-340x800x16.bmp,0,0,10)
+%xl(C,volume-340x800x16.bmp,0,0,10)
+%xl(D,shuffle-340x800x16.bmp,4,0)
+%xl(E,repeat-340x800x16.bmp,0,4,4)
+%xl(shuffleoff,shuffleoff-340x800x16.bmp,0,5)
+%xl(repeatoff,repeatoff-340x800x16.bmp,0,0)
+%xl(F,playmode-340x800x16.bmp,0,0,5)
+#
+# Album Art/Info Viewport Conditional
+%?C<%Vd(a)|%Vd(b)>
+#
+# Progress Bar
+# Backdrop trough occupies x=20..319, y=676..697.
+%V(20,676,300,20,-)
+%pb(0,0,-,20,pb-340x800x16.bmp)
+#
+# Hold
+%V(6,765,38,29,-)
+%?mh<%xd(Aa)|%xd(Ab)>
+#
+# Battery
+%V(59,765,66,29,-)
+%?bp<%?bc<%xd(Ba)|%xd(Bb)>|%?bl<|%xd(Bc)|%xd(Bd)|%xd(Be)|%xd(Bf)|%xd(Bg)|%xd(Bh)|%xd(Bi)|%xd(Bj)>>
+#
+# Volume
+%V(137,765,50,29,-)
+%?pv<%xd(Ca)|%xd(Cb)|%xd(Cc)|%xd(Cd)|%xd(Ce)|%xd(Cf)|%xd(Cg)|%xd(Ch)|%xd(Ci)|%xd(Cj)>
+#
+# Shuffle
+%V(194,765,63,29,-)
+%?ps<%xd(D)|%xd(shuffleoff)>
+#
+# Repeat
+%V(263,761,27,35,-)
+%?mm<%xd(repeatoff)|%xd(Ea)|%xd(Eb)|%xd(Ec)|%xd(Ed)>
+#
+# Playmode
+%V(299,765,36,29,-)
+%?mp<%xd(Fa)|%xd(Fb)|%xd(Fc)|%xd(Fd)|%xd(Fe)>
+#
+# Time Elapsed/Remaining
+%V(20,702,300,36,-)
+%al%pc%ac%?Sr<%pe %Sx(of) %pp|%pp %Sx(of) %pe>%ar%pr
+#
+# Album Art
+%ax%Vl(a,20,45,300,300,-)
+%Cl(0,0,300,300,c,c)
+%Cd
+#
+# Track Info - Album Art
+%ax%Vl(a,0,360,-,316,1)
+%s%ac%?id<%id|%?d(1)<%d(1)|%(root%)>>
+%s%ac%?it<%it|%fn>
+%s%ac%?ia<%ia|%?iA<%iA|%?d(2)<%d(2)|%(root%)>>>
+%ac%?iy<%iy|>
+
+%ac%?fv<%(vbr%) |>%fb kbit/s %fc
+
+%s%ac%Sx(Next:) %?Ia<%Ia|%?IA<%IA|%?D(2)<%D(2)|%(root%)>>> - %?It<%It|%Fn>
+#
+# Track Info - No Album Art
+%Vl(b,0,96,-,580,1)
+%s%ac%?id<%id|%?d(1)<%d(1)|%(root%)>>
+%s%ac%?it<%it|%fn>
+%s%ac%?ia<%ia|%?iA<%iA|%?d(2)<%d(2)|%(root%)>>>
+%ac%?iy<%iy|>
+
+%ac%?ig<%ig|>
+%ac%?fv<%(vbr%) |>%fb kbit/s %fc
+
+%ac%Sx(Next:)
+%s%ac%?Id<%Id|%?D(1)<%D(1)|%(root%)>>
+%ac%s%?It<%It|%Fn>

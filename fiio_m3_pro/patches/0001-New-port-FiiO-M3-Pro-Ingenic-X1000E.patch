diff --git a/firmware/target/mips/ingenic_x1000/fiiom3pro/button-fiiom3pro.c b/firmware/target/mips/ingenic_x1000/fiiom3pro/button-fiiom3pro.c
new file mode 100644
index 0000000..8d9b058
--- /dev/null
+++ b/firmware/target/mips/ingenic_x1000/fiiom3pro/button-fiiom3pro.c
@@ -0,0 +1,196 @@
+/***************************************************************************
+ *             __________               __   ___.
+ *   Open      \______   \ ____   ____ |  | _\_ |__   _______  ___
+ *   Source     |       _//  _ \_/ ___\|  |/ /| __ \ /  _ \  \/  /
+ *   Jukebox    |    |   (  <_> )  \___|    < | \_\ (  <_> > <  <
+ *   Firmware   |____|_  /\____/ \___  >__|_ \|___  /\____/__/\_ \
+ *                     \/            \/     \/    \/            \/
+ *
+ * Based on button-shanlingq1.c,
+ * Copyright (C) 2021 Aidan MacDonald, Dana Conrad
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+
+/* FiiO M3 Pro keys, touchscreen and headphone detect.
+ *
+ * CONFIRMED (stock OS + kernel):
+ *  - four GPIO keys, idle high: VOL+ (PA19), VOL- (PB28), POWER (PB31),
+ *    PLAY (PC23). Stock firmware also uses VOL+/VOL- as prev/next.
+ *  - Hynitron CST3xx touch at I2C1 0x1a, interrupt on PB12. Raw x is on a
+ *    0..360 scale, raw y on 0..800, and both axes are mirrored.
+ *  - headphone detect on AXP192 GPIO3: stock writes 0x8e to reg 0x95 and
+ *    reads reg 0x96 bit 4 (1 = inserted).
+ * ASSUMED: keys are active low (they read high at rest).
+ *
+ * Input model: the Shanling Q1 keypad layout is reused, so the 3x3 touch
+ * grid and point mode both work with the existing keymaps. PREV/NEXT are
+ * never reported by hardware; navigation comes from touch.
+ */
+
+#include "button.h"
+#include "touchscreen.h"
+#include "cst3xx.h"
+#include "kernel.h"
+#include "powermgmt.h"
+#include "gpio-ingenic.h"
+#include "irq-x1000.h"
+#include "i2c-ingenic.h"
+#include <stdbool.h>
+
+#ifndef BOOTLOADER
+# include "lcd.h"
+# include "font.h"
+#endif
+
+/* AXP192 GPIO3/GPIO4 registers (not in axp-192.h) */
+#define AXP192_REG_GPIO34FUNCTION   0x95
+#define AXP192_REG_GPIO34STATE      0x96
+#define HP_DETECT_BIT               0x10
+
+#define TOUCH_RAW_W     360
+#define TOUCH_RAW_H     800
+
+static uint8_t hp_detect_reg = 0x00;
+
+#define HPD_POLL_TIME (HZ/2)
+
+static int hp_detect_tmo_cb(struct timeout* tmo)
+{
+    i2c_descriptor* d = (i2c_descriptor*)tmo->data;
+    i2c_async_queue(AXP_PMU_BUS, TIMEOUT_NOBLOCK, I2C_Q_ADD, 0, d);
+    return HPD_POLL_TIME;
+}
+
+static void hp_detect_init(void)
+{
+    static struct timeout tmo;
+    static const uint8_t gpio_reg = AXP192_REG_GPIO34STATE;
+    static i2c_descriptor desc = {
+        .slave_addr = AXP_PMU_ADDR,
+        .bus_cond = I2C_START | I2C_STOP,
+        .tran_mode = I2C_READ,
+        .buffer[0] = (void*)&gpio_reg,
+        .count[0] = 1,
+        .buffer[1] = &hp_detect_reg,
+        .count[1] = 1,
+        .callback = NULL,
+        .arg = 0,
+        .next = NULL,
+    };
+
+    /* Same value the stock driver writes: GPIO3 = digital input */
+    i2c_reg_write1(AXP_PMU_BUS, AXP_PMU_ADDR, AXP192_REG_GPIO34FUNCTION, 0x8e);
+
+    int r = i2c_reg_read1(AXP_PMU_BUS, AXP_PMU_ADDR, gpio_reg);
+    if(r >= 0)
+        hp_detect_reg = r;
+
+    timeout_register(&tmo, &hp_detect_tmo_cb, HPD_POLL_TIME, (intptr_t)&desc);
+}
+
+void button_init_device(void)
+{
+    i2c_ingenic_set_freq(CST3XX_BUS, I2C_FREQ_400K);
+    cst3xx_init();
+
+    /* No reset GPIO: the controller is ready once its supply is up */
+    system_set_irq_handler(GPIO_TO_IRQ(GPIO_CST3XX_INTERRUPT), cst3xx_irq_handler);
+    gpio_set_function(GPIO_CST3XX_INTERRUPT, GPIOF_IRQ_EDGE(0));
+    gpio_enable_irq(GPIO_CST3XX_INTERRUPT);
+
+    hp_detect_init();
+}
+
+static int read_gpio_keys(void)
+{
+    int r = 0;
+    if(!gpio_get_level(GPIO_BTN_POWER))     r |= BUTTON_POWER;
+    if(!gpio_get_level(GPIO_BTN_VOL_UP))    r |= BUTTON_VOL_UP;
+    if(!gpio_get_level(GPIO_BTN_VOL_DOWN))  r |= BUTTON_VOL_DOWN;
+    if(!gpio_get_level(GPIO_BTN_PLAY))      r |= BUTTON_PLAY;
+    return r;
+}
+
+/* Same mapping as the stock driver: scale x from 0..360 to the 340-pixel
+ * width, then mirror both axes. */
+static void touch_to_screen(int raw_x, int raw_y, int* x, int* y)
+{
+    int sx = raw_x * LCD_WIDTH / TOUCH_RAW_W;
+    int sy = raw_y * LCD_HEIGHT / TOUCH_RAW_H;
+    sx = LCD_WIDTH - 1 - MIN(sx, LCD_WIDTH - 1);
+    sy = LCD_HEIGHT - 1 - MIN(sy, LCD_HEIGHT - 1);
+    *x = sx;
+    *y = sy;
+}
+
+int button_read_device(int* data)
+{
+    int r = read_gpio_keys();
+
+    if(cst3xx_state.pressed) {
+        int x, y;
+        touch_to_screen(cst3xx_state.raw_x, cst3xx_state.raw_y, &x, &y);
+        r |= touchscreen_to_pixels(x, y, data);
+    }
+
+    return r;
+}
+
+void touchscreen_enable_device(bool en)
+{
+    cst3xx_enable(en);
+}
+
+bool headphones_inserted(void)
+{
+    return (hp_detect_reg & HP_DETECT_BIT) ? true : false;
+}
+
+#ifndef BOOTLOADER
+static int getbtn(void)
+{
+    int btn;
+    do {
+        btn = button_get_w_tmo(1);
+    } while(btn & (BUTTON_REL|BUTTON_REPEAT));
+    return btn;
+}
+
+/* Debug screen: raw and mapped touch coordinates plus key state. First thing
+ * to check at bring-up: touching a corner should put the crosshair there. */
+bool dbg_fiiom3pro_touchscreen(void)
+{
+    do {
+        int line = 0;
+        int x = 0, y = 0;
+        bool down = cst3xx_state.pressed;
+        if(down)
+            touch_to_screen(cst3xx_state.raw_x, cst3xx_state.raw_y, &x, &y);
+
+        lcd_clear_display();
+        lcd_putsf(0, line++, "points:%d pressed:%d",
+                  cst3xx_state.nr_points, down);
+        lcd_putsf(0, line++, "raw:%d,%d px:%d,%d",
+                  cst3xx_state.raw_x, cst3xx_state.raw_y, x, y);
+        lcd_putsf(0, line++, "keys:%08x hp:%d",
+                  read_gpio_keys(), headphones_inserted());
+        lcd_drawrect(0, 0, LCD_WIDTH, LCD_HEIGHT);
+
+        if(down) {
+            lcd_hline(x-10, x+10, y);
+            lcd_vline(x, y-10, y+10);
+        }
+
+        lcd_update();
+    } while(getbtn() != BUTTON_POWER);
+    return false;
+}
+#endif

+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+
+#ifndef __CST3XX_H__
+#define __CST3XX_H__
+
+/* Hynitron CST3xx capacitive touch controller (single-touch use).
+ *
+ * Protocol as used by the FiiO M3 Pro stock kernel:
+ *  - read 7 bytes from 16-bit register 0xD000
+ *  - byte 6 must be 0xAB, byte 5 & 0x7f = number of touch points
+ *  - byte 0 low nibble == 6 means finger down
+ *  - x = (b1 << 4) | (b3 >> 4), y = (b2 << 4) | (b3 & 0xf)
+ *  - always acknowledge by writing 0xAB to register 0xD000
+ *
+ * The target supplies CST3XX_BUS and CST3XX_ADDR (i2c-target.h) and
+ * calls cst3xx_irq_handler() from the controller's interrupt. Raw
+ * coordinates are reported; scaling/mirroring is up to the target. */
+
+#include "config.h"
+#include <stdbool.h>
+
+struct cst3xx_state {
+    bool pressed;
+    int raw_x;
+    int raw_y;
+    int nr_points;
+};
+
+extern struct cst3xx_state cst3xx_state;
+
+void cst3xx_init(void);
+void cst3xx_enable(bool en);
+void cst3xx_irq_handler(void);
+
+#endif /* __CST3XX_H__ */

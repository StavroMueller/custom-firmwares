+#ifndef __I2C_TARGET_H__
+#define __I2C_TARGET_H__
+
+/* FiiO M3 Pro I2C map, CONFIRMED from /sys/bus/i2c/devices on the stock OS
+ * (bus 1 and 2). The stock kernel bit-bangs the ES9218 on PB23/PB24, which
+ * are the X1000's I2C0 pins, so here we use the I2C0 controller instead. */
+
+#define I2C_ASYNC_BUS_COUNT  3
+#define I2C_ASYNC_QUEUE_SIZE 4
+
+#define ES9218_BUS   0
+/* The ES9218P's address is set by its ADDR pin (0x48 or 0x49). The stock
+ * kernel's address isn't recoverable from sysfs, so audiohw_init() probes
+ * both and stores the one that answers. */
+extern int fiiom3pro_es9218_addr;
+#define ES9218_ADDR  fiiom3pro_es9218_addr
+
+#define CST3XX_BUS   1
+#define CST3XX_ADDR  0x1a
+
+#define AXP_PMU_BUS  2
+#define AXP_PMU_ADDR 0x34
+
+#define TUSB320_BUS  2
+#define TUSB320_ADDR 0x47
+
+#endif /* __I2C_TARGET_H__ */
diff --git a/firmware/target/mips/ingenic_x1000/fiiom3pro/lcd-fiiom3pro.c b/firmware/target/mips/ingenic_x1000/fiiom3pro/lcd-fiiom3pro.c

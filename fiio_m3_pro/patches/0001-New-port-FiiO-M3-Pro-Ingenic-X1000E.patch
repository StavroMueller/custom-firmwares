+/* ---------------------------------------------------------------------
+ * ST7701S over 3-wire SPI. Each word is 9 bits: D/C (0 = command,
+ * 1 = data), then 8 bits MSB first, sampled on SCK rising edge. The stock
+ * driver uses 5 us per half-period and toggles CS around every word.
+ * ------------------------------------------------------------------- */
+
+#define ST_CMD(c)       (0x000 | (c))
+#define ST_DAT(d)       (0x100 | (d))
+#define ST_DELAY(ms)    (0x8000 | (ms))
+#define ST_END          0xffff
+
+/* Verbatim from the stock kernel. The stock code waits only ~1 ms after
+ * sleep-out; the ST7701S datasheet asks for 120 ms, which is used here. */
+static const uint16_t st7701s_init[] = {
+    ST_CMD(0x11), ST_DELAY(120),                            /* sleep out */
+
+    /* Command2 BK0 */

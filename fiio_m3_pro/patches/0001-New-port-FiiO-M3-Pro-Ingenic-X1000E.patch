+
+#include "backlight.h"
+#include "backlight-target.h"
+#include "lcd.h"
+#include "pwm-x1000.h"
+#include "gpio-ingenic.h"
+
+/* CONFIRMED on a running M3 Pro while sweeping the stock brightness slider:
+ * the backlight is X1000 PWM0 on PC25 (TCU channel 0's half-compare tracks
+ * the setting linearly; PC25 switches to its PWM function when the screen
+ * is on). Supply is switched by PC3 ("BL LDO ENABLE"). 24 MHz / 2400 ->
+ * 10 kHz (100000 ns), active-high, same register convention as
+ * pwm-x1000.c. (PC24 is labelled "pwm4" in the stock kernel but unused.) */
+#define BL_LCD_CHN    0
+#define BL_LCD_PERIOD 100000
+
+static int backlight_calc_duty(int period, int min_duty, int brightness)
+{
+    return min_duty + (period - min_duty) * brightness / MAX_BRIGHTNESS_SETTING;
+}
+
+bool backlight_hw_init(void)
+{
+    gpio_set_level(GPIO_BL_LDO_EN, 1);
+    pwm_init(BL_LCD_CHN);
+    pwm_enable(BL_LCD_CHN);
+    backlight_hw_brightness(MAX_BRIGHTNESS_SETTING);
+    return true;
+}
+
+void backlight_hw_on(void)
+{
+    gpio_set_level(GPIO_BL_LDO_EN, 1);
+    pwm_enable(BL_LCD_CHN);
+#ifdef HAVE_LCD_ENABLE
+    lcd_enable(true);
+#endif
+}
+
+void backlight_hw_off(void)
+{
+    pwm_disable(BL_LCD_CHN);
+    gpio_set_level(GPIO_BL_LDO_EN, 0);
+#ifdef HAVE_LCD_ENABLE
+    lcd_enable(false);
+#endif
+}
+
+void backlight_hw_brightness(int brightness)
+{
+    int duty_ns = backlight_calc_duty(BL_LCD_PERIOD, 0, brightness);
+    pwm_set_period(BL_LCD_CHN, BL_LCD_PERIOD, duty_ns);
+}

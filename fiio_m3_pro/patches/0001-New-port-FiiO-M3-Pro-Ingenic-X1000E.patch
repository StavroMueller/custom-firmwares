+    ST_CMD(0xc0), ST_DAT(0x63), ST_DAT(0x00),               /* line setting */
+    ST_CMD(0xc1), ST_DAT(0x0d), ST_DAT(0x02),               /* porch control */
+    ST_CMD(0xc2), ST_DAT(0x37), ST_DAT(0x02),               /* inversion/clock */
+    ST_CMD(0xcc), ST_DAT(0x10),
+    ST_CMD(0xb0),                                           /* positive gamma */
+        ST_DAT(0x02), ST_DAT(0x13), ST_DAT(0x1b), ST_DAT(0x0d),
+        ST_DAT(0x10), ST_DAT(0x05), ST_DAT(0x08), ST_DAT(0x07),
+        ST_DAT(0x07), ST_DAT(0x24), ST_DAT(0x04), ST_DAT(0x11),
+        ST_DAT(0x0e), ST_DAT(0x2c), ST_DAT(0x33), ST_DAT(0x1d),
+    ST_CMD(0xb1),                                           /* negative gamma */
+        ST_DAT(0x05), ST_DAT(0x13), ST_DAT(0x1b), ST_DAT(0x0d),
+        ST_DAT(0x11), ST_DAT(0x05), ST_DAT(0x08), ST_DAT(0x07),
+        ST_DAT(0x07), ST_DAT(0x24), ST_DAT(0x04), ST_DAT(0x11),
+        ST_DAT(0x0e), ST_DAT(0x2c), ST_DAT(0x33), ST_DAT(0x1d),
+
+    /* Command2 BK1: power settings */
+    ST_CMD(0xff), ST_DAT(0x77), ST_DAT(0x01), ST_DAT(0x00), ST_DAT(0x00), ST_DAT(0x11),
+    ST_CMD(0xb0), ST_DAT(0xb5),
+    ST_CMD(0xb1), ST_DAT(0x80),
+    ST_CMD(0xb2), ST_DAT(0x05),
+    ST_CMD(0xb3), ST_DAT(0x80),
+    ST_CMD(0xb5), ST_DAT(0x4c),
+    ST_CMD(0xb7), ST_DAT(0x85),
+    ST_CMD(0xb8), ST_DAT(0x30),
+    ST_CMD(0xbb), ST_DAT(0x00),
+    ST_CMD(0xc1), ST_DAT(0x08),
+    ST_CMD(0xc2), ST_DAT(0x08),
+    ST_CMD(0xd0), ST_DAT(0x88),
+    ST_DELAY(1),
+
+    /* GIP timing */
+    ST_CMD(0xe0), ST_DAT(0x00), ST_DAT(0x00), ST_DAT(0x02),
+    ST_CMD(0xe1),
+        ST_DAT(0x01), ST_DAT(0xa0), ST_DAT(0x03), ST_DAT(0xa0),
+        ST_DAT(0x02), ST_DAT(0xa0), ST_DAT(0x04), ST_DAT(0xa0),
+        ST_DAT(0x00), ST_DAT(0x44), ST_DAT(0x44),
+    ST_CMD(0xe2),
+        ST_DAT(0x00), ST_DAT(0x00), ST_DAT(0x00), ST_DAT(0x00),
+        ST_DAT(0x00), ST_DAT(0x00), ST_DAT(0x00), ST_DAT(0x00),
+        ST_DAT(0x00), ST_DAT(0x00), ST_DAT(0x00), ST_DAT(0x00),
+    ST_CMD(0xe3), ST_DAT(0x00), ST_DAT(0x00), ST_DAT(0x33), ST_DAT(0x33),
+    ST_CMD(0xe4), ST_DAT(0x44), ST_DAT(0x44),
+    ST_CMD(0xe5),
+        ST_DAT(0x01), ST_DAT(0x26), ST_DAT(0xa0), ST_DAT(0x80),
+        ST_DAT(0x03), ST_DAT(0x28), ST_DAT(0xa0), ST_DAT(0x80),
+        ST_DAT(0x05), ST_DAT(0x2a), ST_DAT(0xa0), ST_DAT(0x80),
+        ST_DAT(0x07), ST_DAT(0x2c), ST_DAT(0xa0), ST_DAT(0x80),
+    ST_CMD(0xe6), ST_DAT(0x00), ST_DAT(0x00), ST_DAT(0x33), ST_DAT(0x33),
+    ST_CMD(0xe7), ST_DAT(0x44), ST_DAT(0x44),
+    ST_CMD(0xe8),
+        ST_DAT(0x02), ST_DAT(0x26), ST_DAT(0xa0), ST_DAT(0x80),
+        ST_DAT(0x04), ST_DAT(0x28), ST_DAT(0xa0), ST_DAT(0x80),
+        ST_DAT(0x06), ST_DAT(0x2a), ST_DAT(0xa0), ST_DAT(0x80),
+        ST_DAT(0x08), ST_DAT(0x2c), ST_DAT(0xa0), ST_DAT(0x80),
+    ST_CMD(0xeb),
+        ST_DAT(0x00), ST_DAT(0x00), ST_DAT(0xe4), ST_DAT(0xe4),
+        ST_DAT(0x44), ST_DAT(0x00), ST_DAT(0x40),
+    ST_CMD(0xed),
+        ST_DAT(0xff), ST_DAT(0xf0), ST_DAT(0x17), ST_DAT(0x65),
+        ST_DAT(0x4a), ST_DAT(0xbf), ST_DAT(0xaf), ST_DAT(0xff),
+        ST_DAT(0xff), ST_DAT(0xfa), ST_DAT(0xfb), ST_DAT(0xa4),
+        ST_DAT(0x56), ST_DAT(0x71), ST_DAT(0x0f), ST_DAT(0xff),
+
+    /* Back to Command1 */
+    ST_CMD(0xff), ST_DAT(0x77), ST_DAT(0x01), ST_DAT(0x00), ST_DAT(0x00), ST_DAT(0x00),
+    ST_CMD(0x3a), ST_DAT(0x55),                             /* RGB565 */
+    ST_CMD(0x29),                                           /* display on */
+    ST_CMD(0x36), ST_DAT(0x00),
+    ST_END,
+};
+
+static void st7701s_spi_write9(uint16_t word)
+{
+    gpio_set_level(GPIO_LCD_CE, 0);
+    udelay(5);
+    for(int bit = 8; bit >= 0; --bit) {
+        gpio_set_level(GPIO_ST7701S_SDA, (word >> bit) & 1);
+        udelay(5);
+        gpio_set_level(GPIO_ST7701S_SCK, 0);
+        udelay(5);
+        gpio_set_level(GPIO_ST7701S_SCK, 1);
+        udelay(5);
+    }
+    gpio_set_level(GPIO_LCD_CE, 1);
+    udelay(5);
+}
+
+static void st7701s_exec(const uint16_t* seq)
+{
+    for(; *seq != ST_END; ++seq) {
+        if(*seq & 0x8000)
+            mdelay(*seq & 0x7fff);
+        else
+            st7701s_spi_write9(*seq);
+    }
+}
+
+/* ---------------------------------------------------------------------
+ * Target hooks
+ * ------------------------------------------------------------------- */
+
+void lcd_tgt_enable(bool enable)
+{
+    if(enable) {
+        /* Hard reset of the display chain (stock J3_LCD_SSD1963_Reset uses
+         * 1 ms low / 1 ms high; we're more generous). */
+        gpio_set_level(GPIO_LCD_RD, 1);
+        gpio_set_level(GPIO_LCD_CE, 1);
+        gpio_set_level(GPIO_ST7701S_SCK, 1);
+        gpio_set_level(GPIO_LCD_RST, 0);
+        mdelay(5);
+        gpio_set_level(GPIO_LCD_RST, 1);
+        mdelay(20);
+
+        /* SSD1963 first, so the panel has a pixel clock */
+        gpio_set_level(GPIO_LCD_CE, 0);
+        lcd_set_clock(X1000_CLK_SCLK_A, M3PRO_LCD_WR_CLOCK);
+        lcd_exec_commands(ssd1963_cmd_enable);
+
+        /* Then the panel over SPI; CS is shared, so this deselects the
+         * SSD1963 between words. Leave CS asserted for the SLCD bus. */
+        st7701s_exec(st7701s_init);
+        gpio_set_level(GPIO_LCD_CE, 0);
+    } else {
+        lcd_tgt_sleep(true);
+        mdelay(120);
+        gpio_set_level(GPIO_LCD_CE, 1);
+    }
+}
+
+void lcd_tgt_sleep(bool sleep)
+{
+    if(sleep) {
+        st7701s_spi_write9(ST_CMD(0x10));
+        gpio_set_level(GPIO_LCD_CE, 0);
+        lcd_exec_commands(ssd1963_cmd_sleep);
+    } else {
+        lcd_exec_commands(ssd1963_cmd_wake);
+        st7701s_spi_write9(ST_CMD(0x11));
+        mdelay(120);
+        gpio_set_level(GPIO_LCD_CE, 0);
+    }
+}
diff --git a/firmware/target/mips/ingenic_x1000/fiiom3pro/power-fiiom3pro.c b/firmware/target/mips/ingenic_x1000/fiiom3pro/power-fiiom3pro.c

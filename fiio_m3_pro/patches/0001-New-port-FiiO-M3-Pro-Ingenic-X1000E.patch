index 0000000..c154f5c
--- /dev/null
+++ b/firmware/target/mips/ingenic_x1000/fiiom3pro/gpio-target.h
@@ -0,0 +1,44 @@
+/* FiiO M3 Pro GPIO map.
+ *
+ * Every pin below is CONFIRMED on a retail unit: /sys/kernel/debug/gpio and
+ * /proc/interrupts from the stock OS (see fiio_m3_pro/adb-dump/), plus
+ * gpio_request()/gpio_set_value() calls in the FW1.1.1 kernel. The initial
+ * function of each output matches the state the stock OS leaves it in.
+ *
+ * X1000 numbering: GPIO n -> port 'A'+(n/32), pin n%32 (e.g. 44 = PB12). */
+
+/*              Name            Port    Pins            Function */
+DEFINE_PINGROUP(LCD_DATA,       GPIO_A, 0xffff <<  0,   GPIOF_DEVICE(1)) /* 16-bit SLCD */
+DEFINE_PINGROUP(LCD_CONTROL,    GPIO_B,   0x1a << 16,   GPIOF_DEVICE(1)) /* WR, DC, TE */
+DEFINE_PINGROUP(MSC0,           GPIO_A,   0x3f << 20,   GPIOF_DEVICE(1))
+DEFINE_PINGROUP(SFC,            GPIO_A,   0x3f << 26,   GPIOF_DEVICE(1))
+DEFINE_PINGROUP(I2S,            GPIO_B,   0x1f <<  0,   GPIOF_DEVICE(1))
+DEFINE_PINGROUP(I2C0,           GPIO_B,      3 << 23,   GPIOF_DEVICE(0)) /* ES9218 */
+DEFINE_PINGROUP(I2C1,           GPIO_C,      3 << 26,   GPIOF_DEVICE(0)) /* CST3xx touch */
+DEFINE_PINGROUP(I2C2,           GPIO_D,      3 <<  0,   GPIOF_DEVICE(1)) /* AXP192, TUSB320 */
+
+/*          Name                Pin             Function            Stock label */
+DEFINE_GPIO(ES9218_RESET,       GPIO_PA(16),    GPIOF_OUTPUT(0))    /* ES9218_RST */
+DEFINE_GPIO(TUSB320_CC_EN,      GPIO_PA(17),    GPIOF_OUTPUT(0))    /* TUSB320 CC_ENABLE */
+DEFINE_GPIO(BTN_VOL_UP,         GPIO_PA(19),    GPIOF_INPUT)        /* VOL INC & PRE SONG */
+DEFINE_GPIO(MSC0_CD,            GPIO_PB(6),     GPIOF_INPUT)        /* mmc_detect, active low */
+DEFINE_GPIO(TUSB320_INT,        GPIO_PB(7),     GPIOF_INPUT)        /* tusb320_int_gpio */
+DEFINE_GPIO(USB_POWER_ON,       GPIO_PB(8),     GPIOF_OUTPUT(1))    /* GPIO_USB_POWER_ON */
+DEFINE_GPIO(USB_OTG_ID,         GPIO_PB(9),     GPIOF_OUTPUT(1))    /* GPIO_OTG_ID */
+DEFINE_GPIO(AXP_IRQ,            GPIO_PB(10),    GPIOF_INPUT)        /* GPIO_AXP192_IRQ */
+DEFINE_GPIO(USB_DETECT,         GPIO_PB(11),    GPIOF_INPUT)        /* VBUS DETECT_WAKEUP, active high */
+DEFINE_GPIO(CST3XX_INTERRUPT,   GPIO_PB(12),    GPIOF_INPUT)        /* cst3xx gpio irq */
+DEFINE_GPIO(USB_OTG_EN,         GPIO_PB(13),    GPIOF_OUTPUT(0))    /* otg enable pin */
+DEFINE_GPIO(LCD_RST,            GPIO_PB(14),    GPIOF_OUTPUT(1))    /* LCD_SPI_RST (J3_LCD_SSD1963_Reset) */
+DEFINE_GPIO(LCD_RD,             GPIO_PB(16),    GPIOF_OUTPUT(1))    /* GPIO_PB(16) */
+DEFINE_GPIO(LCD_CE,             GPIO_PB(18),    GPIOF_OUTPUT(1))    /* lcd cs: SLCD CS *and* ST7701S SPI CS */
+DEFINE_GPIO(USB_DRVVBUS,        GPIO_PB(25),    GPIOF_OUTPUT(0))    /* GPIO_USB_CHANGE_EN */
+DEFINE_GPIO(BTN_VOL_DOWN,       GPIO_PB(28),    GPIOF_INPUT)        /* VOL DEC & NEXT SONG */
+DEFINE_GPIO(BTN_POWER,          GPIO_PB(31),    GPIOF_INPUT)        /* J3 POWER KEY */
+DEFINE_GPIO(ST7701S_SDA,        GPIO_PC(0),     GPIOF_OUTPUT(0))    /* LCD_SPI_SDA */
+DEFINE_GPIO(ST7701S_SCK,        GPIO_PC(2),     GPIOF_OUTPUT(1))    /* LCD_SPI_CLK, idles high */
+DEFINE_GPIO(BL_LDO_EN,          GPIO_PC(3),     GPIOF_OUTPUT(0))    /* BL LDO ENABLE */
+DEFINE_GPIO(ES9218_MCLK_EN,     GPIO_PC(21),    GPIOF_OUTPUT(0))    /* es9218 mck en */
+DEFINE_GPIO(BTN_PLAY,           GPIO_PC(23),    GPIOF_INPUT)        /* PLAY_PAUSE KEY */
+/* PC25 = PWM0 (backlight), owned by pwm-x1000.c. PC24 ("pwm4" in the stock
+ * kernel) is left as an input; it isn't used. */

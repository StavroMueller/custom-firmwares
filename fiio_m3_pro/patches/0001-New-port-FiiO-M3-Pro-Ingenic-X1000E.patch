diff --git a/firmware/drivers/cst3xx.c b/firmware/drivers/cst3xx.c
new file mode 100644
index 0000000..5a90960
--- /dev/null
+++ b/firmware/drivers/cst3xx.c
@@ -0,0 +1,122 @@
+/***************************************************************************
+ *             __________               __   ___.
+ *   Open      \______   \ ____   ____ |  | _\_ |__   _______  ___
+ *   Source     |       _//  _ \_/ ___\|  |/ /| __ \ /  _ \  \/  /
+ *   Jukebox    |    |   (  <_> )  \___|    < | \_\ (  <_> > <  <
+ *   Firmware   |____|_  /\____/ \___  >__|_ \|___  /\____/__/\_ \
+ *                     \/            \/     \/    \/            \/
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+
+#include "cst3xx.h"
+#include "kernel.h"
+#include "i2c-async.h"
+#include <string.h>
+
+#define CST3XX_REPORT_LEN   7
+#define CST3XX_SYNC_BYTE    0xab
+#define CST3XX_STATUS_DOWN  0x06
+
+struct cst3xx_driver {
+    int i2c_cookie;
+    bool enabled;
+    i2c_descriptor read_desc;   /* reg 0xD000 -> 7 bytes */
+    i2c_descriptor ack_desc;    /* write 0xAB to reg 0xD000 */
+    uint8_t reg[2];
+    uint8_t data[CST3XX_REPORT_LEN];
+    uint8_t ack[3];
+};
+
+static struct cst3xx_driver cst_drv;
+struct cst3xx_state cst3xx_state;
+
+static void cst3xx_read_callback(int status, i2c_descriptor* desc)
+{
+    (void)desc;
+    if(status != I2C_STATUS_OK)
+        return;
+
+    const uint8_t* b = cst_drv.data;
+    if(b[6] != CST3XX_SYNC_BYTE)
+        return;
+
+    int points = b[5] & 0x7f;
+    cst3xx_state.nr_points = points;
+
+    /* The stock driver only handles single touch; treat 0 or >1 points
+     * as no valid contact. */
+    if(points != 1 || (b[0] & 0x0f) != CST3XX_STATUS_DOWN) {
+        cst3xx_state.pressed = false;
+        return;
+    }
+
+    cst3xx_state.raw_x = (b[1] << 4) | (b[3] >> 4);
+    cst3xx_state.raw_y = (b[2] << 4) | (b[3] & 0x0f);
+    cst3xx_state.pressed = true;
+}
+
+void cst3xx_init(void)
+{
+    memset(&cst_drv, 0, sizeof(cst_drv));
+    memset(&cst3xx_state, 0, sizeof(cst3xx_state));
+
+    cst_drv.enabled = true;
+    cst_drv.i2c_cookie = i2c_async_reserve_cookies(CST3XX_BUS, 1);
+
+    cst_drv.reg[0] = 0xd0;
+    cst_drv.reg[1] = 0x00;
+    cst_drv.ack[0] = 0xd0;
+    cst_drv.ack[1] = 0x00;
+    cst_drv.ack[2] = CST3XX_SYNC_BYTE;
+
+    /* Write register address, repeated start, read report */
+    cst_drv.read_desc.slave_addr = CST3XX_ADDR;
+    cst_drv.read_desc.bus_cond   = I2C_START | I2C_STOP;
+    cst_drv.read_desc.tran_mode  = I2C_READ;
+    cst_drv.read_desc.buffer[0]  = cst_drv.reg;
+    cst_drv.read_desc.count[0]   = sizeof(cst_drv.reg);
+    cst_drv.read_desc.buffer[1]  = cst_drv.data;
+    cst_drv.read_desc.count[1]   = sizeof(cst_drv.data);
+    cst_drv.read_desc.callback   = cst3xx_read_callback;
+    cst_drv.read_desc.arg        = 0;
+    cst_drv.read_desc.next       = &cst_drv.ack_desc;
+
+    /* The stock driver acknowledges every report, valid or not */
+    cst_drv.ack_desc.slave_addr = CST3XX_ADDR;
+    cst_drv.ack_desc.bus_cond   = I2C_START | I2C_STOP;
+    cst_drv.ack_desc.tran_mode  = I2C_WRITE;
+    cst_drv.ack_desc.buffer[0]  = cst_drv.ack;
+    cst_drv.ack_desc.count[0]   = sizeof(cst_drv.ack);
+    cst_drv.ack_desc.buffer[1]  = NULL;
+    cst_drv.ack_desc.count[1]   = 0;
+    cst_drv.ack_desc.callback   = NULL;
+    cst_drv.ack_desc.arg        = 0;
+    cst_drv.ack_desc.next       = NULL;
+}
+
+void cst3xx_enable(bool en)
+{
+    /* The controller's sleep command isn't known yet, so "disable" just
+     * stops reporting touches. */
+    cst_drv.enabled = en;
+    if(!en)
+        cst3xx_state.pressed = false;
+}
+
+void cst3xx_irq_handler(void)
+{
+    if(!cst_drv.enabled)
+        return;
+
+    /* Nothing useful to do if the queue is full */
+    i2c_async_queue(CST3XX_BUS, TIMEOUT_NOBLOCK, I2C_Q_ONCE,
+                    cst_drv.i2c_cookie, &cst_drv.read_desc);
+}
